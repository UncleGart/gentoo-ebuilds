 #include <memory.h>
 #include "scale.h"
 
+/* The x32 ABI (ILP32 on x86-64) keeps the 64 bit register set but uses 32 bit
+ * pointers, so GCC substitutes 32 bit registers for the pointer operands of
+ * the asm blocks below.  Two consequences:
+ *
+ *   - an x86-64 memory reference may not mix a 32 bit base register with a
+ *     64 bit index register, so the hand written index register must match
+ *     the width of the compiler supplied base register;
+ *   - a pointer read back out of memory is 4 bytes wide, not 8.
+ *
+ * PG_AX is the scratch register used as a pointer/index, PG_LOADP loads a
+ * pointer from memory into it, PG_LOADI loads an array index into it.
+ */
+#if defined(__ILP32__)
+#define PG_AX "%%" "eax"
+#define PG_LOADP "movl"
+#define PG_LOADI "movl"
+#else
+#define PG_AX "%%" "rax"
+#define PG_LOADP "mov"
+#define PG_LOADI "movslq"
+#endif
+
 /* These functions implement an area-averaging shrinking filter in the
  * X-dimension.
  */
