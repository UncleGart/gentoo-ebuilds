+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_x32() {
+        let x32 = Target::from_resolved_target_triple("x86_64-unknown-linux-gnux32").unwrap();
+        assert!(x32.is_x32());
+        // x32 keeps the x86_64 instruction set, but has 32-bit pointers
+        assert_eq!(x32.target_arch(), Arch::X86_64);
+        assert_eq!(x32.pointer_width(), 32);
+        // Matches the tag `packaging.tags` expects for a 32-bit linux-x86_64 interpreter
+        assert_eq!(x32.get_platform_arch().unwrap(), "i686");
+        assert_eq!(x32.get_minimum_manylinux_tag(), PlatformTag::Linux);
+
+        let x86_64 = Target::from_resolved_target_triple("x86_64-unknown-linux-gnu").unwrap();
+        assert!(!x86_64.is_x32());
+        assert_eq!(x86_64.pointer_width(), 64);
+        assert_eq!(x86_64.get_platform_arch().unwrap(), "x86_64");
+    }
