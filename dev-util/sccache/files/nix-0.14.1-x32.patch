nix 0.14.1 (used by libmount 0.1.15) uses c_long/c_ulong for fields that are
64 bits wide on x32 (x86_64 with 32-bit pointers): mq_attr members,
timespec::tv_nsec and the sysinfo memory counters. Use per-target type
aliases, as later nix releases do (nix-rust/nix#1366).

diff -Naur -x .cargo-checksum.json nix-0.14.1.orig/src/mqueue.rs nix-0.14.1/src/mqueue.rs
--- a/src/mqueue.rs	2019-06-03 09:01:58.000000000 -0400
+++ b/src/mqueue.rs	2026-10-29 13:57:07.849104702 -0400
@@ -5,7 +5,7 @@
 use Result;
 use errno::Errno;
 
-use libc::{self, c_char, c_long, mqd_t, size_t};
+use libc::{self, c_char, mqd_t, size_t};
 use std::ffi::CString;
 use sys::stat::Mode;
 use std::mem;
@@ -28,6 +28,15 @@
     }
 }
 
+// On x32 (x86_64 with 32-bit pointers) the kernel and glibc use 64-bit
+// members in `struct mq_attr`, while `c_long` is only 32 bits wide.
+#[cfg(all(target_arch = "x86_64", target_pointer_width = "32"))]
+#[allow(non_camel_case_types)]
+pub type mq_attr_member_t = i64;
+#[cfg(not(all(target_arch = "x86_64", target_pointer_width = "32")))]
+#[allow(non_camel_case_types)]
+pub type mq_attr_member_t = libc::c_long;
+
 #[repr(C)]
 #[derive(Clone, Copy)]
 #[allow(missing_debug_implementations)]
@@ -46,10 +55,10 @@
 }
 
