+
+//! A `jsonwebtoken` crypto provider backed by the `openssl` crate, so that
+//! JWT signing and verification use the system OpenSSL (or LibreSSL) instead
+//! of `aws-lc-rs` or RustCrypto.
+//!
+//! HMAC (HS*) and RSA (RS*, PS*) algorithms are supported, which covers
+//! everything sccache-dist uses. ECDSA and EdDSA are rejected.
+
+use jwt::crypto::{CryptoProvider, JwtSigner, JwtVerifier, KeyUtils};
+use jwt::errors::{Error, ErrorKind, Result};
+use jwt::jwk::{EllipticCurve, ThumbprintHash};
+use jwt::signature;
+use jwt::{Algorithm, AlgorithmFamily, DecodingKey, DecodingKeyKind, EncodingKey};
+use openssl::bn::BigNum;
+use openssl::hash::{MessageDigest, hash};
+use openssl::memcmp;
+use openssl::pkey::{PKey, Private, Public};
+use openssl::rsa::{Padding, Rsa};
+use openssl::sign::{RsaPssSaltlen, Signer, Verifier};
+
+/// Install the OpenSSL provider as the process-wide `jsonwebtoken` provider.
+///
+/// This must happen before any JWT is encoded or decoded. Calling it more
+/// than once is harmless.
+pub fn install() {
+    // Fails only if a provider was already installed, which is fine.
+    let _ = PROVIDER.install_default();
+}
+
+pub static PROVIDER: CryptoProvider = CryptoProvider {
+    signer_factory: new_signer,
+    verifier_factory: new_verifier,
+    key_utils: KeyUtils {
+        rsa_pub_components_from_private_key,
+        rsa_pub_components_from_public_key,
+        ec_pub_components_from_private_key,
+        ed_pub_components_from_private_key,
+        compute_digest,
+    },
+};
+
+#[derive(Clone, Copy)]
+enum Scheme {
+    Hmac,
+    RsaPkcs1,
+    RsaPss,
+}
+
+fn scheme_and_digest(algorithm: &Algorithm) -> Result<(Scheme, MessageDigest)> {
+    Ok(match algorithm {
+        Algorithm::HS256 => (Scheme::Hmac, MessageDigest::sha256()),
+        Algorithm::HS384 => (Scheme::Hmac, MessageDigest::sha384()),
+        Algorithm::HS512 => (Scheme::Hmac, MessageDigest::sha512()),
+        Algorithm::RS256 => (Scheme::RsaPkcs1, MessageDigest::sha256()),
+        Algorithm::RS384 => (Scheme::RsaPkcs1, MessageDigest::sha384()),
+        Algorithm::RS512 => (Scheme::RsaPkcs1, MessageDigest::sha512()),
+        Algorithm::PS256 => (Scheme::RsaPss, MessageDigest::sha256()),
+        Algorithm::PS384 => (Scheme::RsaPss, MessageDigest::sha384()),
+        Algorithm::PS512 => (Scheme::RsaPss, MessageDigest::sha512()),
+        _ => return Err(ErrorKind::UnsupportedAlgorithm.into()),
+    })
+}
+
+fn provider_error(e: openssl::error::ErrorStack) -> Error {
+    ErrorKind::Provider(e.to_string()).into()
+}
+
+fn rsa_error(e: openssl::error::ErrorStack) -> Error {
+    ErrorKind::InvalidRsaKey(e.to_string()).into()
+}
+
+fn expected_family(scheme: Scheme) -> AlgorithmFamily {
+    match scheme {
+        Scheme::Hmac => AlgorithmFamily::Hmac,
+        Scheme::RsaPkcs1 | Scheme::RsaPss => AlgorithmFamily::Rsa,
+    }
+}
+
+// RFC 7518 section 3.5: for PSS the salt is as long as the digest output and
+// MGF1 uses the same hash function as the signature.
+macro_rules! configure_rsa_padding {
+    ($ctx:expr, $scheme:expr, $digest:expr) => {
+        match $scheme {
+            Scheme::Hmac => Ok(()),
+            Scheme::RsaPkcs1 => $ctx.set_rsa_padding(Padding::PKCS1),
+            Scheme::RsaPss => $ctx
+                .set_rsa_padding(Padding::PKCS1_PSS)
+                .and_then(|()| $ctx.set_rsa_pss_saltlen(RsaPssSaltlen::DIGEST_LENGTH))
+                .and_then(|()| $ctx.set_rsa_mgf1_md($digest)),
+        }
+    };
+}
+
+struct OpensslSigner {
+    algorithm: Algorithm,
+    scheme: Scheme,
+    digest: MessageDigest,
+    key: PKey<Private>,
+}
+
+impl signature::Signer<Vec<u8>> for OpensslSigner {
+    fn try_sign(&self, msg: &[u8]) -> std::result::Result<Vec<u8>, signature::Error> {
+        let sign = || -> std::result::Result<Vec<u8>, openssl::error::ErrorStack> {
+            let mut signer = Signer::new(self.digest, &self.key)?;
+            configure_rsa_padding!(signer, self.scheme, self.digest)?;
+            signer.update(msg)?;
+            signer.sign_to_vec()
+        };
+        sign().map_err(signature::Error::from_source)
+    }
+}
+
+impl JwtSigner for OpensslSigner {
+    fn algorithm(&self) -> Algorithm {
+        self.algorithm
+    }
+}
+
+enum VerifyKey {
+    Hmac(PKey<Private>),
+    Rsa(PKey<Public>),
+}
+
+struct OpensslVerifier {
+    algorithm: Algorithm,
+    scheme: Scheme,
+    digest: MessageDigest,
+    key: VerifyKey,
+}
+
+impl signature::Verifier<Vec<u8>> for OpensslVerifier {
+    fn verify(&self, msg: &[u8], sig: &Vec<u8>) -> std::result::Result<(), signature::Error> {
+        let verified = match &self.key {
+            VerifyKey::Hmac(key) => {
+                let compute = || -> std::result::Result<Vec<u8>, openssl::error::ErrorStack> {
+                    let mut signer = Signer::new(self.digest, key)?;
+                    signer.update(msg)?;
+                    signer.sign_to_vec()
+                };
+                let expected = compute().map_err(signature::Error::from_source)?;
+                // Constant-time comparison; `memcmp::eq` panics on a length mismatch.
+                expected.len() == sig.len() && memcmp::eq(&expected, sig)
+            }
+            VerifyKey::Rsa(key) => {
+                let check = || -> std::result::Result<bool, openssl::error::ErrorStack> {
+                    let mut verifier = Verifier::new(self.digest, key)?;
+                    configure_rsa_padding!(verifier, self.scheme, self.digest)?;
+                    verifier.update(msg)?;
+                    verifier.verify(sig)
+                };
+                // OpenSSL reports some malformed signatures as errors rather
+                // than as a failed verification; both mean "invalid".
+                check().unwrap_or(false)
+            }
+        };
+        if verified {
+            Ok(())
+        } else {
+            Err(signature::Error::new())
+        }
+    }
+}
+
+impl JwtVerifier for OpensslVerifier {
+    fn algorithm(&self) -> Algorithm {
+        self.algorithm
+    }
+}
+
+fn new_signer(algorithm: &Algorithm, key: &EncodingKey) -> Result<Box<dyn JwtSigner>> {
+    let (scheme, digest) = scheme_and_digest(algorithm)?;
+    if key.family() != expected_family(scheme) {
+        return Err(ErrorKind::InvalidKeyFormat.into());
+    }
+    let pkey = match scheme {
+        Scheme::Hmac => PKey::hmac(key.as_bytes()).map_err(provider_error)?,
+        // `EncodingKey` stores RSA private keys as PKCS#1 DER.
+        Scheme::RsaPkcs1 | Scheme::RsaPss => {
+            let rsa = Rsa::private_key_from_der(key.as_bytes()).map_err(rsa_error)?;
+            PKey::from_rsa(rsa).map_err(rsa_error)?
+        }
+    };
+    Ok(Box::new(OpensslSigner {
+        algorithm: *algorithm,
+        scheme,
+        digest,
+        key: pkey,
+    }))
+}
+
+fn rsa_public_key(key: &DecodingKey) -> Result<PKey<Public>> {
+    let rsa = match key.kind() {
+        // `DecodingKey` stores RSA public keys as PKCS#1 DER.
+        DecodingKeyKind::SecretOrDer(der) => {
+            Rsa::public_key_from_der_pkcs1(der).map_err(rsa_error)?
+        }
+        DecodingKeyKind::RsaModulusExponent { n, e } => {
+            let n = BigNum::from_slice(n).map_err(rsa_error)?;
+            let e = BigNum::from_slice(e).map_err(rsa_error)?;
+            Rsa::from_public_components(n, e).map_err(rsa_error)?
+        }
+    };
+    PKey::from_rsa(rsa).map_err(rsa_error)
+}
+
+fn new_verifier(algorithm: &Algorithm, key: &DecodingKey) -> Result<Box<dyn JwtVerifier>> {
+    let (scheme, digest) = scheme_and_digest(algorithm)?;
+    if key.family() != expected_family(scheme) {
+        return Err(ErrorKind::InvalidKeyFormat.into());
+    }
+    let key = match scheme {
+        Scheme::Hmac => {
+            VerifyKey::Hmac(PKey::hmac(key.try_get_as_bytes()?).map_err(provider_error)?)
+        }
+        Scheme::RsaPkcs1 | Scheme::RsaPss => VerifyKey::Rsa(rsa_public_key(key)?),
+    };
+    Ok(Box::new(OpensslVerifier {
+        algorithm: *algorithm,
+        scheme,
+        digest,
+        key,
+    }))
+}
+
+fn rsa_pub_components_from_private_key(der: &[u8]) -> Result<(Vec<u8>, Vec<u8>)> {
+    let rsa = Rsa::private_key_from_der(der).map_err(rsa_error)?;
+    Ok((rsa.n().to_vec(), rsa.e().to_vec()))
+}
+
+fn rsa_pub_components_from_public_key(der: &[u8]) -> Result<(Vec<u8>, Vec<u8>)> {
+    let rsa = Rsa::public_key_from_der_pkcs1(der).map_err(rsa_error)?;
+    Ok((rsa.n().to_vec(), rsa.e().to_vec()))
+}
+
+fn ec_pub_components_from_private_key(
+    _der: &[u8],
+    _alg: Algorithm,
+) -> Result<(EllipticCurve, Vec<u8>, Vec<u8>)> {
+    Err(ErrorKind::UnsupportedAlgorithm.into())
+}
+
+fn ed_pub_components_from_private_key(_der: &[u8], _curve: &EllipticCurve) -> Result<Vec<u8>> {
+    Err(ErrorKind::UnsupportedAlgorithm.into())
+}
+
+fn compute_digest(data: &[u8], hash_function: ThumbprintHash) -> Result<Vec<u8>> {
+    let digest = match hash_function {
+        ThumbprintHash::SHA256 => MessageDigest::sha256(),
+        ThumbprintHash::SHA384 => MessageDigest::sha384(),
+        ThumbprintHash::SHA512 => MessageDigest::sha512(),
+        _ => return Err(ErrorKind::UnsupportedAlgorithm.into()),
+    };
+    Ok(hash(digest, data).map_err(provider_error)?.to_vec())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use jwt::signature::Signer as _;
+    use serde::{Deserialize, Serialize};
+
+    #[derive(Debug, PartialEq, Serialize, Deserialize)]
+    struct Claims {
+        sub: String,
+        exp: u64,
+    }
+
+    fn claims() -> Claims {
+        Claims {
+            sub: "sccache".to_owned(),
+            exp: jwt::get_current_timestamp() + 3600,
+        }
+    }
+
+    #[test]
+    fn hmac_roundtrip_and_rejection() {
+        install();
+        for alg in [Algorithm::HS256, Algorithm::HS384, Algorithm::HS512] {
+            let token = jwt::encode(
+                &jwt::Header::new(alg),
+                &claims(),
+                &EncodingKey::from_secret(b"secret"),
+            )
+            .unwrap();
+            let validation = jwt::Validation::new(alg);
+            let decoded =
+                jwt::decode::<Claims>(&token, &DecodingKey::from_secret(b"secret"), &validation)
+                    .unwrap();
+            assert_eq!(decoded.claims, claims());
+            let err =
+                jwt::decode::<Claims>(&token, &DecodingKey::from_secret(b"wrong"), &validation)
+                    .unwrap_err();
+            assert_eq!(err.kind(), &ErrorKind::InvalidSignature);
+        }
+    }
+
+    #[test]
+    fn hmac_matches_rfc4231() {
+        // RFC 4231 test case 2.
+        install();
+        let signer = new_signer(&Algorithm::HS256, &EncodingKey::from_secret(b"Jefe")).unwrap();
+        let mac = signer.try_sign(b"what do ya want for nothing?").unwrap();
+        let hex: String = mac.iter().map(|b| format!("{:02x}", b)).collect();
+        assert_eq!(
+            hex,
+            "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
+        );
+    }
+
+    #[test]
+    fn rsa_roundtrip_and_rejection() {
+        install();
+        let rsa = Rsa::generate(2048).unwrap();
+        let private_der = rsa.private_key_to_der().unwrap();
+        let public_der = rsa.public_key_to_der_pkcs1().unwrap();
+        let other_public_der = Rsa::generate(2048).unwrap().public_key_to_der_pkcs1().unwrap();
+        for alg in [
+            Algorithm::RS256,
+            Algorithm::RS384,
+            Algorithm::RS512,
+            Algorithm::PS256,
+            Algorithm::PS384,
+            Algorithm::PS512,
+        ] {
+            let token = jwt::encode(
+                &jwt::Header::new(alg),
+                &claims(),
+                &EncodingKey::from_rsa_der(&private_der),
+            )
+            .unwrap();
+            let validation = jwt::Validation::new(alg);
+            let decoded =
+                jwt::decode::<Claims>(&token, &DecodingKey::from_rsa_der(&public_der), &validation)
+                    .unwrap();
+            assert_eq!(decoded.claims, claims());
+
+            let (n, e) = rsa_pub_components_from_public_key(&public_der).unwrap();
+            let by_components = DecodingKey::from_rsa_raw_components(&n, &e);
+            jwt::decode::<Claims>(&token, &by_components, &validation).unwrap();
+
+            let err = jwt::decode::<Claims>(
+                &token,
+                &DecodingKey::from_rsa_der(&other_public_der),
+                &validation,
+            )
+            .unwrap_err();
+            assert_eq!(err.kind(), &ErrorKind::InvalidSignature);
+        }
+    }
+
+    #[test]
+    fn rejects_key_of_wrong_family() {
+        install();
+        let rsa = Rsa::generate(2048).unwrap();
+        let public_der = rsa.public_key_to_der_pkcs1().unwrap();
+        assert!(new_verifier(&Algorithm::HS256, &DecodingKey::from_rsa_der(&public_der)).is_err());
+        assert!(new_verifier(&Algorithm::RS256, &DecodingKey::from_secret(b"secret")).is_err());
+        assert!(new_signer(&Algorithm::ES256, &EncodingKey::from_secret(b"secret")).is_err());
+    }
+}
