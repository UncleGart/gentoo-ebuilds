+/// Returns true if an ICmpZero use whose original operands are pointers may
+/// have its comparison rewritten in the integer domain, using \p IntTy as the
+/// arithmetic type, instead of materialising inttoptr casts.
+///
+/// This is only sound when \p IntTy is exactly as wide as \p PtrTy. LSR may
+/// choose an arithmetic type wider than the pointer -- for example an i64
+/// induction variable on x86_64-unknown-linux-gnux32, where pointers are 32
+/// bits. There, converting the expanded integer back to a pointer truncates,
+/// so the original pointer comparison only inspects the low bits. Comparing at
+/// the wider integer width instead would inspect bits the original comparison
+/// ignored, changing the loop's exit condition and turning a finite loop into
+/// a runaway one.
+static bool canRewritePtrICmpInIntDomain(const DataLayout &DL, Type *PtrTy,
+                                         Type *IntTy) {
+  assert(PtrTy->isPointerTy() && "expected a pointer type");
+  return IntTy->isIntegerTy() &&
+         IntTy->getIntegerBitWidth() == DL.getPointerTypeSizeInBits(PtrTy);
+}
